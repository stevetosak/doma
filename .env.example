# Copy to .env.local for local development (docker-compose Postgres):
#   cp .env.example .env.local

# Postgres connection string. Matches docker-compose.yml's default local
# credentials — change them there and here together if you customize them.
DATABASE_URL="postgresql://doma:doma_dev_password@localhost:5434/doma"

# Port the dev/prod server listens on. Defaults to 3000 if unset.
PORT=3000

# Signs the short-lived OAuth state cookie and (later) other tamper-evident
# cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# doma's own origin — used for the CSRF/Origin check and to build the
# Google OAuth redirect_uri. Defaults to http://localhost:3000 if unset.
APP_ORIGIN="http://localhost:3000"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID,
# type Web application). Login/register/logout work without these; only
# GET /auth/google and its callback need them. See the execution plan's
# runbook (§9) for the exact Console steps.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
